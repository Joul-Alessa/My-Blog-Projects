{
  "kind": "collectionType",
  "collectionName": "mht_tournaments",
  "info": {
    "singularName": "mht-tournament",
    "pluralName": "mht-tournaments",
    "displayName": "MHT-Tournament",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "initial_watching_date": {
      "type": "datetime",
      "required": true
    },
    "initial_watching_date_format": {
      "type": "enumeration",
      "enum": [
        "DD/MM/AAAA",
        "??/MM/AAAA",
        "??/??/AAAA"
      ]
    },
    "end_watching_date": {
      "type": "datetime"
    },
    "end_watching_date_format": {
      "type": "enumeration",
      "enum": [
        "DD/MM/AAAA",
        "??/MM/AAAA",
        "??/??/AAAA"
      ]
    },
    "initial_release_date": {
      "type": "datetime",
      "required": true
    },
    "initial_release_date_format": {
      "type": "enumeration",
      "enum": [
        "DD/MM/AAAA",
        "??/MM/AAAA",
        "??/??/AAAA"
      ]
    },
    "end_release_date": {
      "type": "datetime"
    },
    "end_release_date_format": {
      "type": "enumeration",
      "enum": [
        "DD/MM/AAAA",
        "??/MM/AAAA",
        "??/??/AAAA"
      ]
    },
    "grade": {
      "type": "decimal"
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "required": true
    },
    "mht_league": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::mht-league.mht-league",
      "inversedBy": "mht_tournaments"
    },
    "mht_matches": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::mht-match.mht-match",
      "mappedBy": "mht_tournament"
    }
  }
}
