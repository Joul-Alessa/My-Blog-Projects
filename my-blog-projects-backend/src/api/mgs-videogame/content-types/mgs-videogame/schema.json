    "started_playing_date": {
      "type": "datetime"
    },
    "release_date_format": {
      "type": "enumeration",
      "enum": [
        "DD/MM/AAAA",
        "??/MM/AAAA",
        "??/??/AAAA"
      ]
    },
    "started_playing_date_format": {
      "type": "enumeration",
      "enum": [
        "DD/MM/AAAA",
        "??/MM/AAAA",
        "??/??/AAAA"
      ]
