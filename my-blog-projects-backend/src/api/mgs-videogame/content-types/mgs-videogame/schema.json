{
  "kind": "collectionType",
  "collectionName": "mgs_videogames",
  "info": {
    "singularName": "mgs-videogame",
    "pluralName": "mgs-videogames",
    "displayName": "MGS-Videogame",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
