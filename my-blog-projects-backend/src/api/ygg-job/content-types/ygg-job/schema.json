{
  "kind": "collectionType",
  "collectionName": "ygg_jobs",
  "info": {
    "singularName": "ygg-job",
    "pluralName": "ygg-jobs",
    "displayName": "YGG-Job",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "workplace": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "initial_date": {
      "type": "date",
      "required": true
    },
    "end_date": {
      "type": "date"
    },
    "position": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "order": {
      "type": "integer"
    },
    "ygg_technologies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ygg-technology.ygg-technology"
    },
    "ygg_skills": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ygg-skill.ygg-skill"
    },
    "ygg_profiles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ygg-profile.ygg-profile"
    },
    "slug": {
      "type": "uid"
    }
  }
}
