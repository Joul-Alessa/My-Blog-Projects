{
  "kind": "collectionType",
  "collectionName": "mgs_series",
  "info": {
    "singularName": "mgs-serie",
    "pluralName": "mgs-series",
    "displayName": "MGS-Serie",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid"
    },
    "started_playing_date": {
      "type": "datetime"
    },
    "started_playing_date_format": {
      "type": "enumeration",
      "enum": [
        "DD/MM/AAAA",
        "??/MM/AAAA",
        "??/??/AAAA"
      ]
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "mgs_videogame": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::mgs-videogame.mgs-videogame",
      "inversedBy": "mgs_series"
    },
    "grade": {
      "type": "decimal"
    }
  }
}
