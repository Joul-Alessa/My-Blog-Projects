{
  "kind": "collectionType",
  "collectionName": "ygg_projects",
  "info": {
    "singularName": "ygg-project",
    "pluralName": "ygg-projects",
    "displayName": "YGG-Project",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ygg_technologies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ygg-technology.ygg-technology"
    },
    "ygg_skills": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ygg-skill.ygg-skill"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "review": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "project_type": {
      "type": "enumeration",
      "enum": [
        "personal",
        "learning",
        "product",
        "contribution",
        "collaboration"
      ],
      "required": true
    },
    "know_me_better_project": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "ygg_profiles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ygg-profile.ygg-profile"
    },
    "order": {
      "type": "integer"
    },
    "url": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "required": true
    }
  }
}
